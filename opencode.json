{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "share": "disabled",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "update": "disable",
  "agents": {
    "build": {
      "model": "anthropic/claude-opus-5#high"
    },
    "plan": {
      "model": "anthropic/claude-opus-5#high"
    },
    "general": {
      "model": "anthropic/claude-opus-5#high"
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5"
    },
    "pair-programming": {
      "mode": "primary",
      "description": "Primary agent that proposes every edit for approval before touching the working tree.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        }
      ],
      "model": "anthropic/claude-opus-5#high"
    },
    "title": {
      "model": "anthropic/claude-haiku-4-5"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/secrets/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/credentials*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "amazon-bedrock",
      "effect": "deny"
    }
  ]
}

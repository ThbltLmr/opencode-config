{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "share": "disabled",
  "disabled_providers": [
    "amazon-bedrock"
  ],
  "instructions": [
    "~/.opencode/AGENTS.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials*": "deny"
    }
  },
  "agent": {
    "build": {
      "variant": "high"
    },
    "plan": {
      "variant": "high"
    },
    "general": {
      "variant": "high"
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5"
    },
    "pair-programming": {
      "mode": "primary",
      "description": "Primary agent that proposes every edit for approval before touching the working tree.",
      "variant": "high",
      "permission": {
        "edit": "ask"
      }
    }
  },
  "plugin": [
    "opencode-anthropic-auth@0.0.13"
  ]
}
